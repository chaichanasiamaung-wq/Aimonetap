-- ตัวแปรสถานะฟังก์ชันทั้งหมด
-- ==========================================
local headSizeEnabled = false
local headSizeValue = 1

local espLineEnabled = false
local espBoxEnabled = false

local aimbotEnabled = false
local aimFovRadius = 100

local rainbowAllEnabled = false

-- ==========================================
-- สร้างปุ่มตั้งค่าในเมนู
-- ==========================================
createNumberBox("Head Size (1-15)", 1, 1, 15, 10, function(val)
    headSizeValue = val
end)

createToggle("Head Size Enabled", 60, function(state)
    headSizeEnabled = state
    if not state then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local head = player.Character:FindFirstChild("Head")
                if head then
                    head.Size = Vector3.new(2, 1, 1)
                    head.CanCollide = true
                end
            end
        end
    end
end)

createToggle("ESP: Lines (เส้น)", 110, function(state)
    espLineEnabled = state
end)

createToggle("ESP: Boxes (สี่เหลี่ยม)", 160, function(state)
    espBoxEnabled = state
end)

createToggle("Aimbot Lock", 210, function(state)
    aimbotEnabled = state
end)

createNumberBox("Aimbot FOV Size", 100, 30, 500, 260, function(val)
    aimFovRadius = val
end)

createToggle("Rainbow Players (Wallhack)", 310, function(state)
    rainbowAllEnabled = state
end)

-- ==========================================
-- วงกลม FOV (อยู่กลางหน้าจอเป๊ะๆ)
-- ==========================================
local fovCircle = Drawing.new("Circle")
fovCircle.Thickness = 2
fovCircle.NumSides = 60
fovCircle.Filled = false
fovCircle.Visible = false

local function getClosestPlayerToCenter()
    local closestPlayer = nil
    local shortestDistance = aimFovRadius
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") and player.Character:FindFirstChildOfClass("Humanoid") then
            if player.Character.Humanoid.Health > 0 then
                local headPos, onScreen = Camera:WorldToViewportPoint(player.Character.Head.Position)
                if onScreen then
                    local distance = (Vector2.new(headPos.X, headPos.Y) - screenCenter).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        closestPlayer = player
                    end
                end
            end
        end
    end
    return closestPlayer
end

-- ==========================================
-- ระบบ ESP Cache สำหรับ Lines & Boxes
-- ==========================================
local espCache = {}
local function removeESP(player)
    if espCache[player] then
        if espCache[player].Line then espCache[player].Line:Remove() end
        if espCache[player].Box then espCache[player].Box:Remove() end
        espCache[player] = nil
    end
end
Players.PlayerRemoving:Connect(removeESP)

-- ==========================================
-- ลูปหลักการทำงาน (RenderStepped)
-- ==========================================
RunService.RenderStepped:Connect(function()
    local rainbowColor = Color3.fromHSV(tick() % 3 / 3, 1, 1)

    -- 1. วงกลมกลางจอ & Aimbot ล็อคเป้า
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    fovCircle.Position = screenCenter
    fovCircle.Radius = aimFovRadius
    fovCircle.Color = rainbowColor
    fovCircle.Visible = aimbotEnabled

    if aimbotEnabled then
        local target = getClosestPlayerToCenter()
        if target and target.Character and target.Character:FindFirstChild("Head") then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Character.Head.Position)
        end
    end

    -- 2. ตัวละครทุกคนเป็นสีรุ้ง (รวมหัว/แต่งกาย แบบมองทะลุกำแพง)
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then
            for _, part in ipairs(player.Character:GetDescendants()) do
                if rainbowAllEnabled then
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                        part.Color = rainbowColor
                        part.Material = Enum.Material.Neon -- ทำให้เรืองแสงมองทะลุชัดเจนขึ้น
                    elseif part:IsA("Accessory") and part:FindFirstChild("Handle") then
                        part.Handle.Color = rainbowColor
                        part.Handle.Material = Enum.Material.Neon
                    end
                else
                    -- รีเซ็ตกลับเป็นปกติเมื่อปิด
                    if part:IsA("BasePart") then
                        part.Material = Enum.Material.Plastic
                    end
                end
            end
        end
    end

    -- 3. ขยายหัวผู้เล่นอื่น
    if headSizeEnabled then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local head = player.Character:FindFirstChild("Head")
                if head then
                    head.Size = Vector3.new(headSizeValue, headSizeValue, headSizeValue)
                    head.Transparency = 0.3
                    head.CanCollide = false
                end
            end
        end
    end

    -- 4. ESP (Lines & Boxes)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            if character and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChild("Humanoid") and character.Humanoid.Health > 0 then
                
                if not espCache[player] then
                    local line = Drawing.new("Line")
                    line.Thickness = 1.5
                    line.Color = Color3.fromRGB(255, 0, 0)
                    line.Visible = false

                    local box = Drawing.new("Square")
                    box.Thickness = 1.5
                    box.Color = Color3.fromRGB(0, 255, 0)
                    box.Filled = false
                    box.Visible = false

                    espCache[player] = {Line = line, Box = box}
                end

                local cache = espCache[player]
                local hrp = character.HumanoidRootPart
                local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)

                if onScreen then
                    if espLineEnabled then
                        cache.Line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        cache.Line.To = Vector2.new(vector.X, vector.Y)
                        cache.Line.Visible = true
                    else
                        cache.Line.Visible = false
                    end

                    if espBoxEnabled then
                        local headPos = Camera:WorldToViewportPoint(character.Head.Position + Vector3.new(0, 0.5, 0))
                        local legPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                        
                        local height = math.abs(headPos.Y - legPos.Y)
                        local width = height / 2

                        cache.Box.Size = Vector2.new(width, height)
                        cache.Box.Position = Vector2.new(vector.X - width / 2, headPos.Y)
                        cache.Box.Visible = true
                    else
                        cache.Box.Visible = false
                    end
                else
                    cache.Line.Visible = false
                    cache.Box.Visible = false
                end
            else
                removeESP(player)
            end
        end
    end
end)
